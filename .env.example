DATABASE_PATH=/absolute/path/to/Event-collection.db
CONCERT_DATABASE_PATH=/absolute/path/to/Concert-collection.db
NFL_DATABASE_PATH=/absolute/path/to/NFL-collection.db
NHL_DATABASE_PATH=/absolute/path/to/NHL-collection.db
FLASK_SECRET_KEY=replace-with-a-random-secret
COLLECTOR_INGEST_TOKEN=replace-with-a-separate-random-secret

# Production database backend. Keep sqlite until the migration tool verifies all data.
TICKETSIGNAL_DATABASE_BACKEND=sqlite
MYSQL_HOST=your-account.mysql.pythonanywhere-services.com
MYSQL_USERNAME=your-account
MYSQL_PASSWORD_B64=base64-encoded-password
MYSQL_MLB_DATABASE=your-account$ticketsignal_mlb
MYSQL_NFL_DATABASE=your-account$ticketsignal_nfl
MYSQL_NHL_DATABASE=your-account$ticketsignal_nhl
